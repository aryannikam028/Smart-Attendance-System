# ==============================================================================
# SMART ATTENDANCE SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your production credentials.
# NEVER commit .env or .env.local to version control!
# ==============================================================================

# 1. Google Apps Script Integration (SERVER ONLY - NEVER expose to frontend)
APPS_SCRIPT_URL=YOUR_GOOGLE_APPS_SCRIPT_DEPLOYMENT_URL
APPS_SCRIPT_SHARED_SECRET=YOUR_SHARED_SECRET

# 2. Cryptographic Session Signing (Generate with: openssl rand -base64 32)
JWT_SECRET=YOUR_RANDOM_SECRET_MINIMUM_32_CHARACTERS

# 3. Administrator Root Credentials (Stored on server only)
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD

# 4. Institutional Policy & Configuration
ATTENDANCE_MIN_PERCENT=75
TOP_PERFORMER_PERCENT=90
COLLEGE_NAME=Yashoda Technical Campus, Satara (YSPM)
DEPARTMENT_NAME=Electronics & Telecommunication Engineering
CLASS_DIVISION=Final Year B.Tech (Division B)
ACADEMIC_YEAR=2026-2027
SEMESTER=Sem VII
